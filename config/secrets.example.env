# Copy to secrets.env and fill in. secrets.env is git-ignored and should be chmod 600.
# Format: NAME=value   (no quotes, no spaces around =). Lines starting with # are ignored.
# Real environment variables with the same name override this file.
# To change account access later, just edit the values here and re-run.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Free key: https://www.eia.gov/opendata/
EIA_API_KEY=
# Optional, raises CFTC rate limits (free). Leave empty to run without it.
CFTC_APP_TOKEN=
# Anthropic API key for the news pipeline (console.anthropic.com). Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Alice Blue
ALICEBLUE_USER_ID=
ALICEBLUE_API_KEY=
# Telegram (used later, when delivery is set up)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
